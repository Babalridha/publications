---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const { 
  title = "Bab al-Ridha Publications", 
  description = "A mission-driven educational showcase for scholarly Islamic publications, featuring academic authority and institutional clarity.",
  isHome = false
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
  </head>
  <body class="flex flex-col min-h-screen bg-[#fcfbf7]">
    <Navbar isHome={isHome} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
