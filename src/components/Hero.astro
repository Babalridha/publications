---
import { ArrowRight, ChevronLeft, ChevronRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import siteData from '../data/site-data.json';
import patternImg from '../assets/images/pattern.png';

const { sliderImages } = siteData;

// Glob all matching slider images in the assets folder
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{webp,png,jpg,jpeg}');
---
<section class="relative h-screen min-h-[600px] flex items-center overflow-hidden bg-slate-900">
  <!-- Slides -->
  {sliderImages.map((img, idx) => {
    const imgResolved = images[img];
    if (!imgResolved) {
      throw new Error(`Image not found at path: ${img}`);
    }
    return (
      <div 
        class={`hero-slide absolute inset-0 transition-all duration-1000 ease-in-out transform ${
          idx === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-110 pointer-events-none'
        }`}
        data-index={idx}
      >
        <div class="absolute inset-0 bg-gradient-to-r from-emerald-950/90 via-emerald-900/60 to-transparent z-10" />
        <Image 
          src={imgResolved()} 
          alt={`Slide ${idx + 1}`} 
          class="w-full h-full object-cover object-center"
        />
      </div>
    );
  })}

  <!-- Decorative Overlay -->
  <div 
    class="absolute inset-0 opacity-[0.03] pointer-events-none z-20" 
    style={{ backgroundImage: `url(${patternImg.src})`, backgroundSize: '300px' }}
  ></div>

  <!-- Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-30">
    <div class="max-w-3xl space-y-8">
      <div class="space-y-4 animate-in fade-in slide-in-from-left-8 duration-700">
        <p class="text-emerald-400 font-black tracking-[0.4em] uppercase text-xs">Propagating the Wisdom of the Ahlulbayt (a)</p>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif text-white leading-[1.1]">
          Bridging Sacred <br />
          <span class="italic text-emerald-200">Knowledge</span> & <br />
          Modern Research.
        </h1>
        <p class="text-xl text-slate-200 max-w-xl font-light leading-relaxed">
          Bab al-Ridha Institute publishes high-quality research, commentary, and literature rooted in the profound traditions of the Hawza for the global seeker.
        </p>
      </div>

      <div class="flex flex-wrap gap-4 animate-in fade-in slide-in-from-bottom-8 duration-1000">
        <a 
          href="/books" 
          class="bg-emerald-600 text-white px-10 py-5 rounded-sm font-black hover:bg-emerald-500 transition-all flex items-center gap-2 group tracking-widest text-xs uppercase shadow-2xl"
        >
          CHECK OUR BOOKS
          <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
        <a 
          href="/how-to-buy" 
          class="bg-white/10 backdrop-blur-md border-2 border-white/20 text-white px-10 py-5 rounded-sm font-black hover:bg-white/20 transition-all tracking-widest text-xs uppercase"
        >
          HOW TO BUY
        </a>
      </div>
    </div>
  </div>

  <!-- Controls -->
  <div class="absolute bottom-10 right-10 flex gap-4 z-40">
    <button id="hero-prev" class="p-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-full text-white transition-all cursor-pointer">
      <ChevronLeft class="w-6 h-6" />
    </button>
    <button id="hero-next" class="p-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-full text-white transition-all cursor-pointer">
      <ChevronRight class="w-6 h-6" />
    </button>
  </div>

  <!-- Indicators -->
  <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex gap-3 z-40">
    {sliderImages.map((_, idx) => (
      <button 
        class={`hero-indicator h-1 transition-all duration-300 rounded-full cursor-pointer ${idx === 0 ? 'w-12 bg-emerald-500' : 'w-4 bg-white/30'}`}
        data-index={idx}
        aria-label={`Go to slide ${idx + 1}`}
      />
    ))}
  </div>
</section>

<script>
  function setupHeroSlider() {
    const slides = document.querySelectorAll('.hero-slide');
    const indicators = document.querySelectorAll('.hero-indicator');
    const nextBtn = document.getElementById('hero-next');
    const prevBtn = document.getElementById('hero-prev');

    if (slides.length === 0) return;

    let current = 0;
    const totalSlides = slides.length;

    function showSlide(index: number) {
      slides.forEach((slide, idx) => {
        const slideEl = slide as HTMLElement;
        if (idx === index) {
          slideEl.classList.remove('opacity-0', 'scale-110', 'pointer-events-none');
          slideEl.classList.add('opacity-100', 'scale-100', 'z-10');
        } else {
          slideEl.classList.remove('opacity-100', 'scale-100', 'z-10');
          slideEl.classList.add('opacity-0', 'scale-110', 'pointer-events-none');
        }
      });

      indicators.forEach((indicator, idx) => {
        const indicatorEl = indicator as HTMLElement;
        if (idx === index) {
          indicatorEl.classList.remove('w-4', 'bg-white/30');
          indicatorEl.classList.add('w-12', 'bg-emerald-500');
        } else {
          indicatorEl.classList.remove('w-12', 'bg-emerald-500');
          indicatorEl.classList.add('w-4', 'bg-white/30');
        }
      });
    }

    function nextSlide() {
      current = (current + 1) % totalSlides;
      showSlide(current);
    }

    function prevSlide() {
      current = (current - 1 + totalSlides) % totalSlides;
      showSlide(current);
    }

    let interval = setInterval(nextSlide, 6000);

    function resetTimer() {
      clearInterval(interval);
      interval = setInterval(nextSlide, 6000);
    }

    nextBtn?.addEventListener('click', () => {
      nextSlide();
      resetTimer();
    });

    prevBtn?.addEventListener('click', () => {
      prevSlide();
      resetTimer();
    });

    indicators.forEach((indicator) => {
      indicator.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const index = parseInt(target.dataset.index || '0', 10);
        current = index;
        showSlide(current);
        resetTimer();
      });
    });
  }

  // Run on initial load
  setupHeroSlider();

  // Run on Astro page navigation if using view transitions
  document.addEventListener('astro:after-swap', setupHeroSlider);
</script>
