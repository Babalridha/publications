---
import { Star, Truck, BookText, Globe, FileText, ShoppingCart, ArrowLeft } from '@lucide/astro';
import SectionHeader from '../SectionHeader.astro';
import { Image } from 'astro:assets';
import patternImg from '../../assets/images/pattern.png';

interface Props {
  book: {
    id: string;
    title: string;
    subtitle?: string;
    author: string;
    translator?: string;
    editor?: string;
    category: string;
    coverImage: string;
    rating: number;
    prices: {
      hardcover: number;
      paperback: number;
      ebook: number;
    };
    specs: {
      isbn: string;
      pageCount: number;
      weight: string;
      dimensions: string;
    };
    blurb: string;
    authorBio: string;
    authorImage: string;
  };
}

const { book } = Astro.props;

// Dynamically resolve local image assets
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{webp,png,jpg,jpeg}');
const coverResolved = images[book.coverImage];
const authorResolved = images[book.authorImage];

if (!coverResolved) {
  throw new Error(`Cover image not found for path: ${book.coverImage}`);
}
if (!authorResolved) {
  throw new Error(`Author image not found for path: ${book.authorImage}`);
}
---
<div class="bg-[#fcfbf7] min-h-screen pt-24 md:pt-32">
  {/* Product Hero Section */}
  <section class="pb-16 md:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/" class="inline-flex items-center gap-2 text-emerald-800 font-bold text-xs uppercase tracking-widest mb-12 hover:gap-3 transition-all">
        <ArrowLeft class="w-4 h-4" /> Back to Library
      </a>

      <div class="grid lg:grid-cols-2 gap-16 items-start">
        {/* Visual Column - Sticky on Desktop only */}
        <div class="lg:sticky lg:top-32">
          <div class="relative group">
            <div class="absolute -inset-10 bg-emerald-900/5 blur-[100px] rounded-full opacity-50"></div>
            <Image 
              src={coverResolved()} 
              alt={book.title} 
              class="relative w-full max-w-sm mx-auto shadow-2xl rounded-sm border-l-4 border-slate-200"
            />
          </div>
        </div>

        {/* Content Column */}
        <div class="space-y-10">
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <div class="flex text-amber-500">
                {Array.from({ length: book.rating || 5 }).map(() => (
                  <Star class="w-[18px] h-[18px] fill-amber-500 text-amber-500" />
                ))}
              </div>
              <span class="text-[10px] font-black tracking-widest text-slate-500 uppercase">Verified Masterpiece</span>
            </div>
            <h1 class="text-5xl md:text-6xl font-serif text-slate-900 leading-tight uppercase">{book.title}</h1>
            {book.subtitle && <p class="text-2xl text-emerald-800 font-serif italic">{book.subtitle}</p>}
            <div class="flex flex-wrap gap-x-8 gap-y-4 text-xs font-black text-slate-400 pt-6 border-t border-slate-100 uppercase tracking-widest">
              <div class="flex flex-col">
                <span class="text-[9px] mb-1">Author</span>
                <span class="text-slate-900">{book.author}</span>
              </div>
              {book.translator && (
                <div class="flex flex-col">
                  <span class="text-[9px] mb-1">Translator</span>
                  <span class="text-slate-900">{book.translator}</span>
                </div>
              )}
              {book.editor && (
                <div class="flex flex-col">
                  <span class="text-[9px] mb-1">Editor</span>
                  <span class="text-slate-900">{book.editor}</span>
                </div>
              )}
            </div>
          </div>

          {/* Pricing Grid */}
          <div class="grid grid-cols-3 gap-3">
            {Object.entries(book.prices).map(([format, price]) => (
              <button class="p-5 border border-slate-200 rounded-sm text-center hover:border-emerald-800 hover:bg-emerald-50 transition-all bg-white group shadow-sm cursor-pointer">
                <span class="block text-[10px] uppercase font-black text-slate-400 mb-1 tracking-widest group-hover:text-emerald-800">{format}</span>
                <span class="block text-xl font-serif font-bold text-slate-900">${price}</span>
              </button>
            ))}
          </div>

          {/* CTAs */}
          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <button class="flex-1 bg-emerald-900 text-white py-6 rounded-sm font-black text-xs tracking-[0.2em] hover:bg-emerald-800 transition-all flex items-center justify-center gap-3 shadow-xl uppercase cursor-pointer">
              <ShoppingCart class="w-[18px] h-[18px]" /> BUY FROM AMAZON
            </button>
            <a href="/how-to-buy" class="flex-1 bg-white border border-slate-200 text-slate-800 py-6 rounded-sm font-black text-xs tracking-[0.2em] hover:bg-slate-50 transition-all flex items-center justify-center uppercase text-center leading-[1] flex items-center justify-center">
              LOCAL AGENTS
            </a>
          </div>

          {/* Technical Sheet */}
          <div class="grid grid-cols-2 gap-y-8 pt-10 border-t border-slate-100">
            <div class="flex items-center gap-4">
              <div class="p-3 bg-emerald-50 rounded-full text-emerald-800"><BookText class="w-5 h-5" /></div>
              <div>
                <span class="block text-slate-400 font-black uppercase text-[9px] tracking-widest">ISBN</span>
                <span class="text-sm text-slate-900 font-bold">{book.specs.isbn}</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-emerald-50 rounded-full text-emerald-800"><FileText class="w-5 h-5" /></div>
              <div>
                <span class="block text-slate-400 font-black uppercase text-[9px] tracking-widest">Pages</span>
                <span class="text-sm text-slate-900 font-bold">{book.specs.pageCount} Pages</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-emerald-50 rounded-full text-emerald-800"><Globe class="w-5 h-5" /></div>
              <div>
                <span class="block text-slate-400 font-black uppercase text-[9px] tracking-widest">Dimensions</span>
                <span class="text-sm text-slate-900 font-bold">{book.specs.dimensions}</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-emerald-50 rounded-full text-emerald-800"><Truck class="w-5 h-5" /></div>
              <div>
                <span class="block text-slate-400 font-black uppercase text-[9px] tracking-widest">Weight</span>
                <span class="text-sm text-slate-900 font-bold">{book.specs.weight}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Blurb Section */}
  <section class="py-24 bg-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.02] pointer-events-none" style={{backgroundImage: `url(${patternImg.src})`, backgroundSize: '400px'}}></div>
    <div class="max-w-4xl mx-auto px-4 text-center space-y-12 relative z-10">
      <div class="h-px w-20 bg-emerald-800 mx-auto"></div>
      <p class="text-2xl md:text-3xl font-serif text-slate-900 leading-relaxed font-light italic">
        "{book.blurb}"
      </p>
      <div class="h-px w-20 bg-emerald-800 mx-auto"></div>
    </div>
  </section>

  {/* Author Section */}
  <section class="py-24 bg-[#fcfbf7] border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader title="About the Author" subtitle="Scholarly Pedigree" />
      <div class="max-w-5xl mx-auto bg-white rounded-sm shadow-xl overflow-hidden flex flex-col md:flex-row items-center border border-slate-100">
        <div class="md:w-2/5 h-[400px] overflow-hidden">
          <Image src={authorResolved()} alt={book.author} class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700" />
        </div>
        <div class="md:w-3/5 p-12 lg:p-16 space-y-8">
          <div class="space-y-2">
            <span class="text-emerald-800 font-black tracking-[0.4em] uppercase text-[9px]">Expert Profile</span>
            <h3 class="text-4xl font-serif text-slate-900 leading-tight">{book.author}</h3>
          </div>
          <p class="text-lg text-slate-600 leading-relaxed font-light">
            {book.authorBio}
          </p>
          <div class="flex gap-4 pt-4">
            <span class="px-4 py-2 bg-emerald-900 text-white text-[10px] font-black rounded-full uppercase tracking-widest">Official Publication</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
