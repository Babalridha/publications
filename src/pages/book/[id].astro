---
import Layout from '../../layouts/Layout.astro';
import BookTemplate from '../../components/BookTemplate.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('books');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { book: entry.data },
  }));
}

const { book } = Astro.props;
---
<Layout title={`${book.title} - Bab al-Ridha Publications`} description={book.blurb}>
  <BookTemplate book={book} variant={book.variant || "default"} />
</Layout>
