---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Bab al-Ridha Publications" description="The requested page could not be found." robots="noindex">
  <section class="mx-auto max-w-2xl px-6 py-32 text-center">
    <p class="font-bold tracking-widest text-emerald-800">404</p>
    <h1 class="mt-4 text-4xl font-bold">Page not found</h1>
    <p class="mt-4">The page you requested does not exist.</p>
    <a class="mt-8 inline-block rounded bg-emerald-800 px-6 py-3 text-white" href="/">Return home</a>
  </section>
</Layout>
